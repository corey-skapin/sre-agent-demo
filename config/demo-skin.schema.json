{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "customer", "azure", "sre", "labels", "codeContext", "tags"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "customer": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "shortName", "scenarioLabel"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "shortName": { "type": "string", "minLength": 1 },
        "scenarioLabel": { "type": "string", "minLength": 1 }
      }
    },
    "azure": {
      "type": "object", "additionalProperties": false,
      "required": ["namePrefix", "location"],
      "properties": {
        "namePrefix": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,19}$" },
        "location": { "type": "string", "pattern": "^[a-z][a-z0-9]+$" }
      }
    },
    "sre": {
      "type": "object", "additionalProperties": false,
      "required": ["accessLevel", "targetArcMachine", "nativeContainerFaultState", "t10Scenario", "lobFaultMode"],
      "properties": {
        "accessLevel": { "enum": ["High", "Low"] },
        "targetArcMachine": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$" },
        "nativeContainerFaultState": { "const": "Status" },
        "t10Scenario": { "enum": ["HeartbeatByBackingVm", "StopService", "DiskPressure", "CpuPressure", "WriteEvent"] },
        "lobFaultMode": { "enum": ["CrashOnProcessing", "Degraded"] },
        "requiredScenarios": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["T09", "T10", "T11", "SQL", "T12", "ASK", "MEMORY", "PROACTIVE", "ARC"] } },
        "sqlTargetArcMachine": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$" }
      }
    },
    "labels": {
      "type": "object", "additionalProperties": false,
      "required": ["demoTitle", "agentName", "containerResponsePlan", "lobAlertTitleContains", "lobAppName", "lobEventSource", "lobTaskName"],
      "properties": {
        "demoTitle": { "type": "string", "minLength": 1 },
        "agentName": { "type": "string", "pattern": "^[A-Za-z][-A-Za-z0-9]{0,30}[A-Za-z0-9]$" },
        "containerResponsePlan": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" },
        "lobResponsePlan": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" },
        "lobAlertTitleContains": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_. -]{0,79}$" },
        "lobAppName": { "type": "string", "minLength": 1 },
        "lobEventSource": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$" },
        "lobTaskName": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$" },
        "sqlResponsePlan": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" },
        "sqlAlertTitleContains": { "const": "Arc SQL lock timeout" },
        "sqlEventSource": { "const": "ArcSqlEngineDemo" }
      }
    },
    "codeContext": {
      "type": "object", "additionalProperties": false,
      "required": ["lobRepositoryUrl", "lobSourceCommit", "lobSourcePath"],
      "properties": {
        "lobRepositoryUrl": { "type": "string", "pattern": "^$|^https://[^\\s]+$" },
        "lobSourceCommit": { "type": "string", "pattern": "^$|^[A-Za-z0-9._-]+$" },
        "lobSourcePath": { "type": "string", "minLength": 1 }
      },
      "allOf": [{
        "if": { "properties": { "lobRepositoryUrl": { "const": "" } } },
        "then": { "properties": { "lobSourceCommit": { "const": "" } } },
        "else": { "properties": { "lobSourceCommit": { "minLength": 1 } } }
      }]
    },
    "release": {
      "type": "object", "additionalProperties": false,
      "required": ["location", "appRepository", "goodVersion", "badVersion"],
      "properties": {
        "resourceGroup": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,89}$" },
        "location": { "type": "string", "pattern": "^[a-z][a-z0-9]+$" },
        "appRepository": { "type": "string", "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$" },
        "goodVersion": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "badVersion": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "appServiceSku": { "enum": ["B1", "B2", "B3"] },
        "handlerName": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,62}$" },
        "responsePlan": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" }
      }
    },
    "memory": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "seedPath": { "type": "string" }
      }
    },
    "tags": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "allOf": [{
    "if": { "properties": { "sre": {
      "required": ["requiredScenarios"],
      "properties": { "requiredScenarios": { "contains": { "const": "SQL" } } }
    } } },
    "then": { "properties": {
      "sre": { "required": ["sqlTargetArcMachine"] },
      "labels": { "required": ["sqlResponsePlan", "sqlAlertTitleContains", "sqlEventSource"] }
    } }
  }, {
    "if": { "properties": { "sre": {
      "required": ["requiredScenarios"],
      "properties": { "requiredScenarios": { "contains": { "const": "T12" } } }
    } } },
    "then": { "required": ["release"] }
  }, {
    "if": { "properties": { "sre": {
      "required": ["requiredScenarios"],
      "properties": { "requiredScenarios": { "contains": { "const": "PROACTIVE" } } }
    } } },
    "then": { "properties": { "sre": { "properties": { "requiredScenarios": { "contains": { "const": "T12" } } } } } }
  }, {
    "if": { "properties": { "sre": {
      "required": ["requiredScenarios"],
      "properties": { "requiredScenarios": { "contains": { "const": "ARC" } } }
    } } },
    "then": { "properties": { "sre": { "properties": { "accessLevel": { "const": "High" }, "requiredScenarios": { "contains": { "const": "T11" } } } } } }
  }]
}
